generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  uid                  String    @id @default(uuid()) @db.Char(36)
  email                String    @unique @db.VarChar(255)
  nickname             String    @db.VarChar(255)
  profileImageUrl      String?   @map("profile_image_url") @db.Text
  profileS3Key         String?   @map("profile_s3_key") @db.VarChar(255)
  reminderAlarmActive  Boolean   @default(true) @map("reminder_alarm_active")
  sensitiveAlarmActive Boolean   @default(true) @map("sensitive_alarm_active")
  curationAlarmActive  Boolean   @default(true) @map("curation_alarm_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime? @updatedAt @map("updated_at")
  pushToken            String?   @map("push_token") @db.VarChar(255)
  role                 Role      @default(USER)
  birth                DateTime  @map("birth") @db.Date
  postLikes            PostLike[]
  postBookmarks        PostBookmark[]

  @@map("users")
}

model Oauth {
  oauthId    BigInt     @id @default(autoincrement()) @map("oauth_id")
  uid        String     @db.Char(36)
  socialType SocialType @map("social_type")
  providerId String     @map("provider_id") @db.VarChar(255)
  password   String?    @map("password") @db.Text
  loginEmail String     @map("login_email") @db.VarChar(255)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime?  @updatedAt @map("updated_at")

  @@unique([uid, socialType])
  @@index([loginEmail, socialType])
  @@map("oauth")
}

model Term {
  termId   BigInt   @id @default(autoincrement()) @map("term_id")
  termName TermName @default(NONE) @map("term_name")

  @@map("term")
}

model UserTerm {
  userTermId BigInt    @id @default(autoincrement()) @map("user_term_id")
  uid        String    @db.Char(36)
  termId     BigInt    @map("term_id")
  termActive Boolean   @default(false) @map("term_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@index([termId], map: "user_term_term_id_fkey")
  @@index([uid], map: "user_term_uid_fkey")
  @@map("user_term")
}

model CurationCategory {
  categoryId BigInt               @id @default(autoincrement()) @map("category_id")
  name       CurationCategoryName
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime?            @updatedAt @map("updated_at")
  posts      CurationPost[]

  @@map("curation_categories")
}

model CurationPost {
  postId            BigInt    @id @default(autoincrement()) @map("post_id")
  title             String    @db.VarChar(255)
  content           String    @db.Text
  source            String?   @db.VarChar(255)
  thumbnailUrl      String?   @map("thumbnail_url") @db.Text
  viewCount         Int       @default(0) @map("view_count")
  isPublished       Boolean   @default(true) @map("is_published")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  categoryId        BigInt    @map("category_id")
  estimatedReadTime Int       @map("estimated_read_time")
  category          CurationCategory @relation(fields: [categoryId], references: [categoryId])
  likes             PostLike[]
  bookmarks         PostBookmark[]

  @@index([categoryId], map: "curation_posts_category_id_fkey")
  @@map("curation_posts")
}

model PostLike {
  likesId   BigInt   @id @default(autoincrement()) @map("likes_id")
  createdAt DateTime @default(now()) @map("created_at")
  postId    BigInt   @map("post_id")
  uid       String   @db.Char(36)
  post      CurationPost @relation(fields: [postId], references: [postId], onDelete: Cascade)
  user      User         @relation(fields: [uid], references: [uid], onDelete: Cascade)

  @@index([postId], map: "post_likes_post_id_fkey")
  @@index([uid], map: "post_likes_uid_fkey")
  @@map("post_likes")
}

model PostBookmark {
  bookmarkId BigInt   @id @default(autoincrement()) @map("bookmark_id")
  createdAt  DateTime @default(now()) @map("created_at")
  postId     BigInt   @map("post_id")
  uid        String   @db.Char(36)
  post       CurationPost @relation(fields: [postId], references: [postId], onDelete: Cascade)
  user       User         @relation(fields: [uid], references: [uid], onDelete: Cascade)

  @@index([postId], map: "post_bookmarks_post_id_fkey")
  @@index([uid], map: "post_bookmarks_uid_fkey")
  @@map("post_bookmarks")
}

model SearchHistory {
  searchHistoryId BigInt   @id @default(autoincrement()) @map("search_history_id")
  keyword         String   @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")
  uid             String   @db.Char(36)

  @@index([uid], map: "search_histories_uid_fkey")
  @@map("search_histories")
}

model AudioCategory {
  categoryId   BigInt    @id @map("category_id")
  categoryName String    @map("category_name") @db.VarChar(50)
  createdAt    DateTime  @map("created_at")
  updatedAt    DateTime? @map("updated_at")
  codeId       Int       @map("code_id")

  @@index([codeId], map: "audio_category_code_id_fkey")
  @@map("audio_category")
}

model AudioCode {
  id       Int    @id @default(autoincrement())
  codeName String @unique @map("code_name") @db.VarChar(50)

  @@map("audio_code")
}

model AudioGuide {
  audioId    BigInt    @id @map("audio_id")
  categoryId BigInt    @map("category_id")
  audioTitle String    @map("audio_title") @db.VarChar(50)
  audioUrl   String    @map("audio_url") @db.Text
  audioKey   String    @map("audio_key") @db.VarChar(255)
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@index([categoryId], map: "audio_guide_category_id_fkey")
  @@map("audio_guide")
}

model AudioLiked {
  likedId   BigInt   @id @default(autoincrement()) @map("liked_id")
  audioId   BigInt   @map("audio_id")
  uid       String   @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([audioId, uid])
  @@index([uid], map: "audio_liked_uid_fkey")
  @@map("audio_liked")
}

model AudioSave {
  saveId    BigInt   @id @default(autoincrement()) @map("save_id")
  audioId   BigInt   @map("audio_id")
  uid       String   @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([audioId, uid])
  @@index([uid], map: "audio_save_uid_fkey")
  @@map("audio_save")
}

enum Role {
  USER
  ADMIN
}

enum SocialType {
  KAKAO
  LOCAL
}

enum TermName {
  NONE
}

enum CurationCategoryName {
  HSP_TIP   @map("HSP팁")
  RESEARCH  @map("연구")
  BREATHING @map("호흡법")
  SOUND     @map("사운드")
}
